# =============================================================================
# K2 Factory OS — Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงจาก Supabase Dashboard
#   (Project Settings → API)
# =============================================================================

# URL ของโปรเจกต์ Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Anon/Public key — ปลอดภัยที่จะใช้ฝั่ง browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role key — ใช้เฉพาะฝั่ง server เท่านั้น! ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
